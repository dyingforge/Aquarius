{
  "name": "aquarius",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aquarius — a single-user, local long-term memory service for coding agents.",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.10.0"
  },
  "scripts": {
    "typecheck": "tsc -b --pretty",
    "build": "tsc -b --pretty",
    "clean": "tsc -b --clean && rm -rf packages/*/dist",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=2 \"packages/*/src/**/*.test.ts\"",
    "server": "node --disable-warning=ExperimentalWarning packages/server/src/main.ts",
    "cli": "node --disable-warning=ExperimentalWarning packages/cli/src/main.ts",
    "test:core": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"packages/core/src/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "typescript": "5.9.3"
  }
}
